datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String? // null si usó Google
  name         String?
  avatar       String?
  googleId     String?   @unique // null si usó email/password
  isSubscribed Boolean   @default(false)
  favorites    Perfume[] @relation("FavoritePerfumes")
  cart         Cart?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Perfume {
  id          String      @id @default(uuid())
  name        String      @unique
  type        PerfumeType
  gender      Gender
  description String?
  image       String?
  price       Decimal     @db.Decimal(10, 2)
  discount    Int         @default(0)
  stock       Int         @default(0)
  remainingMl Int         @default(100)
  rating      Decimal     @default(0.0) @db.Decimal(3, 2)
  reviewCount Int         @default(0)

  // Métricas de la Comunidad (Relaciones 1 a 1)
  longevity Longevity?
  sillage   Sillage?
  decants   Decant[]
  season    Season?
  feeling   Feeling?

  // Relaciones
  designerId  String
  designer    Designer    @relation(fields: [designerId], references: [id])
  accords     Accord[]    @relation("PerfumeAccords")
  notes       Note[]
  tags        Tag[]       @relation("Tags")
  reviews     Review[]
  favoritedBy User[]      @relation("FavoritePerfumes")
  cartItems   CartItem[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decant {
  id         String      @id @default(uuid())
  ml         Int
  price      Decimal     @db.Decimal(10, 2)
  image      String?
  stock      Int         @default(0)
  perfumeId  String
  perfume    Perfume     @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([perfumeId, ml])
}

model Designer {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  image       String?
  description String? @db.Text
  showInHome  Boolean @default(false)

  perfumes Perfume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feeling {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  love        Int @default(0) // Me encanta
  like        Int @default(0) // Me gusta
  indifferent Int @default(0) // Me es indiferente
  dislike     Int @default(0) // No me gusta
  hate        Int @default(0) // Lo odio
}

model Season {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  winter Int @default(0) // Invierno
  spring Int @default(0) // Primavera
  summer Int @default(0) // Verano
  autumn Int @default(0) // Otoño

  day   Int @default(0) // Día
  night Int @default(0) // Noche
}

model Longevity {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  scarce   Int @default(0) // e.g. 120 voted for this
  weak     Int @default(0)
  moderate Int @default(0)
  long     Int @default(0)
  veryLong Int @default(0)
}

model Sillage {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  soft     Int @default(0)
  moderate Int @default(0)
  heavy    Int @default(0)
  huge     Int @default(0)
}

model Accord {
  id       String    @id @default(uuid())
  name     String    @unique
  icon     String?
  perfumes Perfume[] @relation("PerfumeAccords")
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  perfumes Perfume[] @relation("Tags")
}

model Note {
  id        String    @id @default(uuid())
  perfumeId String
  perfume   Perfume   @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  name      String
  image     String?
  stage     NoteStage
}

model Review {
  id        String   @id @default(uuid())
  perfumeId String
  perfume   Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  userName  String
  comment   String   @db.Text
  rating    Int
  createdAt DateTime @default(now())
}

model Banner {
  id       String  @id @default(uuid())
  title    String
  text     String
  image    String
  slug     String  @default("/")
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vibe {
  id          String  @id @default(uuid())
  name        String
  image       String?
  description String?
  slug        String
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  perfumeId String
  perfume   Perfume  @relation(fields: [perfumeId], references: [id])
  decantId  String?
  decant    Decant?  @relation(fields: [decantId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  shipping        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  shippingAddress String?     @db.Text
  notes           String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  perfumeId String
  perfume   Perfume  @relation(fields: [perfumeId], references: [id])
  decantId  String?
  decant    Decant?  @relation(fields: [decantId], references: [id])
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

enum PerfumeType {
  ARABIC
  DESIGNER
  DECANT
  NICHE
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum NoteStage {
  TOP
  HEART
  BASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}
