datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Perfume {
  id          String      @id @default(uuid())
  name        String      @unique
  designer    String
  type        PerfumeType
  gender      Gender
  description String?
  image       String?
  price       Decimal     @db.Decimal(10, 2)
  discount    Int         @default(0)
  stock       Int         @default(0)
  remainingMl Int         @default(100)
  rating      Decimal     @default(0.0) @db.Decimal(3, 2)
  reviewCount Int         @default(0)

  // Métricas de la Comunidad (Relaciones 1 a 1)
  longevity Longevity?
  sillage   Sillage?
  decants   Decant[]
  season    Season?
  feeling   Feeling?

  // Relaciones
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  notes      Note[]
  tags       Tag[]    @relation("Tags")
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decant {
  id        String  @id @default(uuid())
  ml        Int
  price     Decimal @db.Decimal(10, 2)
  image     String?
  stock     Int     @default(0)
  perfumeId String
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([perfumeId, ml])
}

model Feeling {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  love        Int @default(0) // Me encanta
  like        Int @default(0) // Me gusta
  indifferent Int @default(0) // Me es indiferente
  dislike     Int @default(0) // No me gusta
  hate        Int @default(0) // Lo odio
}

model Season {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  winter Int @default(0) // Invierno
  spring Int @default(0) // Primavera
  summer Int @default(0) // Verano
  autumn Int @default(0) // Otoño

  day   Int @default(0) // Día
  night Int @default(0) // Noche
}

model Longevity {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  // Vote count fields for each option
  scarce   Int @default(0) // e.g. 120 voted for this
  weak     Int @default(0)
  moderate Int @default(0)
  long     Int @default(0)
  veryLong Int @default(0)
}

model Sillage {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  // Vote count fields for each option
  soft     Int @default(0)
  moderate Int @default(0)
  heavy    Int @default(0)
  huge     Int @default(0)
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  perfumes Perfume[]
}

model Tag {
  id          String    @id @default(uuid())
  name        String    @unique
  image       String?
  description String?
  showInHome  Boolean   @default(false)
  perfumes    Perfume[] @relation("Tags")
}

model Note {
  id        String    @id @default(uuid())
  perfumeId String
  perfume   Perfume   @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  name      String
  stage     NoteStage
}

model Review {
  id        String   @id @default(uuid())
  perfumeId String
  perfume   Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  userName  String
  comment   String   @db.Text
  rating    Int
  createdAt DateTime @default(now())
}

model Banner {
  id       String  @id @default(uuid())
  title    String
  text     String
  image    String
  link     String  @default("/")
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ENUMS (Tipos estrictos para evitar errores de tipeo)
// ==========================================

enum PerfumeType {
  ARABIC
  DESIGNER
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum NoteStage {
  TOP
  HEART
  BASE
}
