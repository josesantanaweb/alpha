datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String? // null si usó Google
  name      String?
  avatar    String?
  googleId  String?    @unique // null si usó email/password
  favorites Perfume[]  @relation("FavoritePerfumes")
  cart      Cart?
  orders    Order[]
  reviews      Review[]
  votes        UserVote[]
  reviewVotes  ReviewVote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Perfume {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  type        PerfumeType
  gender      Gender
  description String?
  image       String?
  price       Decimal     @db.Decimal(10, 2)
  discount    Int         @default(0)
  stock       Int         @default(0)
  remainingMl Int         @default(100)
  rating      Decimal     @default(0.0) @db.Decimal(3, 2)
  reviewCount Int         @default(0)

  // Métricas de la Comunidad (Relaciones 1 a 1)
  longevity  Longevity?
  sillage    Sillage?
  decants    Decant[]
  season     Season?
  timeOfDay  TimeOfDay?
  feeling    Feeling?
  projection Projection?

  // Relaciones
  designerId String
  designer   Designer        @relation(fields: [designerId], references: [id])
  accords    PerfumeAccord[]
  notes      Note[]
  tags       Tag[]           @relation("Tags")
  reviews    Review[]
  users      User[]          @relation("FavoritePerfumes")
  cartItems  CartItem[]
  orderItems OrderItem[]
  votes      UserVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decant {
  id         String      @id @default(uuid())
  ml         Int
  price      Decimal     @db.Decimal(10, 2)
  image      String?
  stock      Int         @default(0)
  perfumeId  String
  perfume    Perfume     @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([perfumeId, ml])
}

model Designer {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  image       String?
  description String? @db.Text
  showInHome  Boolean @default(false)

  perfumes Perfume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feeling {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  love    Int @default(0) // Me encanta
  like    Int @default(0) // Me gusta
  dislike Int @default(0) // No me gusta
  hate    Int @default(0) // Lo odio
}

model Season {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  winter Int @default(0) // Invierno
  spring Int @default(0) // Primavera
  summer Int @default(0) // Verano
  autumn Int @default(0) // Otoño
}

model TimeOfDay {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  day   Int @default(0) // Día
  night Int @default(0) // Noche
}

model Longevity {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  weak     Int @default(0)
  moderate Int @default(0)
  long     Int @default(0)
  veryLong Int @default(0)
}

model Sillage {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  soft     Int @default(0)
  moderate Int @default(0)
  heavy    Int @default(0)
  huge     Int @default(0)
}

model Projection {
  id        String  @id @default(uuid())
  perfumeId String  @unique
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  soft     Int @default(0)
  moderate Int @default(0)
  heavy    Int @default(0)
  huge     Int @default(0)
}

model Accord {
  id       String          @id @default(uuid())
  name     String          @unique
  perfumes PerfumeAccord[]
}

model PerfumeAccord {
  perfumeId  String
  accordId   String
  percentage Int

  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  accord  Accord  @relation(fields: [accordId], references: [id], onDelete: Cascade)

  @@id([perfumeId, accordId])
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  perfumes Perfume[] @relation("Tags")
}

model Note {
  id        String    @id @default(uuid())
  perfumeId String
  perfume   Perfume   @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  name      String
  image     String?
  stage     NoteStage
}

model Review {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfumeId       String
  perfume         Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  title           String?
  comment         String   @db.Text
  rating          Int
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  votes           ReviewVote[]
  createdAt       DateTime @default(now())

  @@unique([userId, perfumeId])
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful Boolean
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model Banner {
  id       String  @id @default(uuid())
  title    String
  text     String
  image    String
  slug     String  @default("/")
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vibe {
  id          String  @id @default(uuid())
  name        String
  image       String?
  description String?
  slug        String
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  perfumeId String
  perfume   Perfume  @relation(fields: [perfumeId], references: [id])
  decantId  String?
  decant    Decant?  @relation(fields: [decantId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Order {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)

  deliveryMethod DeliveryMethod @default(DELIVERY)
  currency       Currency       @default(VES)
  paymentMethod  PaymentMethod  @default(MOBILE_PAYMENT)

  contactName  String
  contactEmail String
  contactPhone String

  city    String? @db.VarChar(100)
  address String? @db.Text

  // Totales
  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  perfumeId String
  perfume   Perfume  @relation(fields: [perfumeId], references: [id])
  decantId  String?
  decant    Decant?  @relation(fields: [decantId], references: [id])
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(uuid())
  title     String   @unique
  slug      String   @unique
  content   String   @db.Text
  excerpt   String?  @db.Text
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PerfumeType {
  ARABIC
  DESIGNER
  NICHE
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum NoteStage {
  TOP
  HEART
  BASE
}

model UserVote {
  id        String @id @default(uuid())
  userId    String
  perfumeId String
  category  String // "season" | "timeOfDay" | "longevity" | "sillage" | "projection" | "feeling"
  field     String // "winter", "spring", "day", "soft", etc.

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfume Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([userId, perfumeId, category])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum Currency {
  VES
  USD
}

enum PaymentMethod {
  MOBILE_PAYMENT
  BINANCE
  ZINLI
  CASH
}
