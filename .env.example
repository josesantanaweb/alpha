# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alpha_db?schema=public"

# S3 / Object Storage
S3_ENDPOINT="https://s3.amazonaws.com"       # Optional — omit for AWS S3, set for MinIO / DigitalOcean Spaces / etc.
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="aura-uploads"
S3_PUBLIC_URL="https://aura-uploads.s3.amazonaws.com"

# Auth
AUTH_SECRET="a3f8b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0"
