# DATABASE_URL LOCAL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alpha_db

# DATABASE_URL POOLER
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# DATABASE_URL TRANSACTION
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# S3 / Object Storage
S3_ENDPOINT="https://s3.amazonaws.com"       # Optional — omit for AWS S3, set for MinIO / DigitalOcean Spaces / etc.
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="alpha-uploads"
S3_PUBLIC_URL="https://alpha-uploads.s3.amazonaws.com"

# Auth
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TOKEN_EXPIRATION="1h"

# Google OAuth (configurar en https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
